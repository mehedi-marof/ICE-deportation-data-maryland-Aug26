show_all()
departed |> filter(other, departure_country %in% c("GHANA", "SIERRA LEONE")) |> count(citizenship_country, departure_country) |>
show_all()
stays <- detained |> distinct(stay_ID, apprehension_criminality, departed = !is.na(departed_date))
